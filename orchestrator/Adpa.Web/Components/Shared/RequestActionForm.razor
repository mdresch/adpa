@inject IHttpClientFactory HttpClientFactory

<GovernorCard>
    <div class="d-flex justify-content-between align-items-start mb-2">
        <div style="font-size:16px; font-weight:700;">@Title</div>
        <StatusChip Label="@ModuleId" State="StatusChip.ChipState.Neutral" />
    </div>

    @if (Mode == ActionMode.BreakGlass)
    {
        <p style="font-size:12.5px; color:var(--gp-soft);">
            This path exists for structural deadlock -- the owning department has fewer than two active
            members in this portfolio, so a normal override (two distinct department signatures) isn't
            possible. It is not a convenience shortcut around the normal process.
        </p>
    }

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_step == 1)
    {
        <div class="mb-2">
            <label class="form-label" style="font-size:12.5px; color:var(--gp-soft);">Requested new status</label>
            <select class="form-select" @bind="_targetStatus">
                @foreach (var status in AllowedNextStatuses)
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>

        <div class="mb-2">
            <label class="form-label" style="font-size:12.5px; color:var(--gp-soft);">@JustificationLabel</label>
            <textarea class="form-control" rows="3" @bind="_justification" @bind:event="oninput" @onblur="() => _justificationTouched = true"></textarea>
            @if (_justificationTouched && string.IsNullOrWhiteSpace(_justification))
            {
                <div class="text-danger" style="font-size:12px;">@JustificationLabel is required.</div>
            }
        </div>

        @* Review finding (PR #744): promote_capability_status requires a non-null, existing
           p_draco_verdict_id for every ->active transition (server/migrations/436_draco_
           activation_gate.sql). Hiding this field for Promote mode meant a direct promotion
           to active could never actually succeed -- it would always 400. Shown for every
           mode now; still optional client-side (ADR-012 §3 defers real DRACO evidence
           validation/preview here until ADR-005 Item 5's DRACO integration lands), so a
           promotion targeting a status other than active is unaffected. *@
        <div class="mb-3">
            <label class="form-label" style="font-size:12.5px; color:var(--gp-soft);">DRACO verdict ID (optional)</label>
            <input class="form-control" @bind="_dracoVerdictId" />
        </div>

        <div class="d-flex gap-2">
            @if (Mode == ActionMode.Promote)
            {
                <PillButton Variant="PillButton.ButtonVariant.Primary" Disabled="@(!CanAdvance || _submitting)" OnClick="SubmitAsync">Promote</PillButton>
            }
            else
            {
                <PillButton Variant="PillButton.ButtonVariant.Primary" Disabled="@(!CanAdvance)" OnClick="() => _step = 2">Review request</PillButton>
            }
            <PillButton Variant="PillButton.ButtonVariant.Secondary" OnClick="Cancel">Cancel</PillButton>
        </div>
    }
    else
    {
        <p style="font-size:12.5px; color:var(--gp-soft); font-weight:600;">Step 2 of 2 -- review before submitting</p>

        <div class="mb-2" style="font-size:13px;">
            <div><b>Target status:</b> @_targetStatus</div>
        </div>
        <JustificationBlock>@_justification</JustificationBlock>

        @if (Mode == ActionMode.Override)
        {
            <p style="font-size:12px; color:var(--gp-soft); margin-top:8px;">
                A second, distinct active member of this module's owning department must approve before this
                takes effect. Once approved, the override is valid for 72 hours from approval.
            </p>
        }
        else if (Mode == ActionMode.BreakGlass)
        {
            <p style="font-size:12px; color:var(--gp-soft); margin-top:8px;">
                This raises a request reviewed by the account owner, portfolio escalation manager, Internal
                Audit, and any configured external auditor -- it does not itself activate anything. Only a
                Super Admin's explicit pickup finalizes the activation.
            </p>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="breakGlassConfirm" @bind="_breakGlassConfirmed" />
                <label class="form-check-label" for="breakGlassConfirm" style="font-size:12.5px;">
                    I confirm no eligible second approver exists in this department for this portfolio.
                </label>
            </div>
        }

        <div class="d-flex gap-2 mt-2">
            <PillButton Variant="PillButton.ButtonVariant.Primary" Disabled="@(!CanSubmitStep2 || _submitting)" OnClick="SubmitAsync">Submit request</PillButton>
            <PillButton Variant="PillButton.ButtonVariant.Secondary" OnClick="() => _step = 1">Back</PillButton>
        </div>
    }
</GovernorCard>

@code {
    public enum ActionMode { Promote, Override, BreakGlass }

    [Parameter, EditorRequired] public ActionMode Mode { get; set; }
    [Parameter, EditorRequired] public string ModuleId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string PortfolioId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public List<string> AllowedNextStatuses { get; set; } = new();
    [Parameter] public EventCallback OnCompleted { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private int _step = 1;
    private string _targetStatus = string.Empty;
    private string _justification = string.Empty;
    private string? _dracoVerdictId;
    private bool _justificationTouched;
    private bool _breakGlassConfirmed;
    private bool _submitting;
    private string? _error;

    private string Title => Mode switch
    {
        ActionMode.Promote => "Promote",
        ActionMode.Override => "Request override",
        ActionMode.BreakGlass => "Raise break-glass exception",
        _ => string.Empty
    };

    private string JustificationLabel => Mode == ActionMode.Promote ? "Reason" : "Justification";

    private bool CanAdvance => !string.IsNullOrWhiteSpace(_justification) && !string.IsNullOrEmpty(_targetStatus);

    private bool CanSubmitStep2 => Mode != ActionMode.BreakGlass || _breakGlassConfirmed;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(_targetStatus) && AllowedNextStatuses.Count > 0)
        {
            _targetStatus = AllowedNextStatuses[0];
        }
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        _error = null;
        try
        {
            var client = HttpClientFactory.CreateClient("api");
            HttpResponseMessage response;

            if (Mode == ActionMode.Promote)
            {
                response = await client.PostAsJsonAsync(
                    $"api/Capability/{ModuleId}/{PortfolioId}/promote",
                    new PromoteDraft
                    {
                        NewStatus = _targetStatus,
                        Reason = _justification,
                        DracoVerdictId = string.IsNullOrWhiteSpace(_dracoVerdictId) ? null : _dracoVerdictId
                    });
            }
            else
            {
                var path = Mode == ActionMode.Override
                    ? $"api/Capability/{ModuleId}/{PortfolioId}/override/request"
                    : $"api/Capability/{ModuleId}/{PortfolioId}/exceptions/request";
                response = await client.PostAsJsonAsync(
                    path,
                    new OverrideRequestDraft
                    {
                        RequestedNewStatus = _targetStatus,
                        Justification = _justification,
                        DracoVerdictId = string.IsNullOrWhiteSpace(_dracoVerdictId) ? null : _dracoVerdictId
                    });
            }

            if (response.IsSuccessStatusCode)
            {
                await OnCompleted.InvokeAsync();
                return;
            }

            var body = await response.Content.ReadAsStringAsync();
            _error = $"Could not submit ({(int)response.StatusCode}): {body}";
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the orchestrator: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task Cancel() => await OnCancelled.InvokeAsync();
}
