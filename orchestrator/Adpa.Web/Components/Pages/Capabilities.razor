@page "/capabilities"
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject CurrentUserService CurrentUser
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization

<PageTitle>Capabilities — Governor Portal</PageTitle>

<h1 class="h3 mb-1" style="font-family: var(--gp-font); color: var(--gp-ink);">Capability Register</h1>
<p class="mb-4" style="color: var(--gp-soft);">Every governed module your departments own, and its current activation status.</p>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_activeCapability is not null && _activeMode is not null)
{
    <div class="mb-4" style="max-width: 480px;">
        @* @key forces a fresh instance (and thus reset internal form state) whenever the
           target capability or mode changes -- without it, switching from one card's form
           to another's without submitting/cancelling first would carry over stale field
           values (wrong target-status options, leftover justification text). *@
        <RequestActionForm @key="@($"{_activeCapability.ModuleId}-{_activeCapability.PortfolioId}-{_activeMode}")"
                            Mode="@_activeMode.Value"
                            ModuleId="@_activeCapability.ModuleId"
                            PortfolioId="@_activeCapability.PortfolioId"
                            AllowedNextStatuses="@AllowedNextStatuses(_activeCapability.ActivationStatus)"
                            OnCompleted="OnFormCompleted"
                            OnCancelled="CloseForm" />
    </div>
}

@if (_loading)
{
    <p style="color: var(--gp-soft);">Loading&hellip;</p>
}
else if (_capabilities.Count == 0)
{
    <p style="color: var(--gp-soft);">No capabilities visible to your account.</p>
}
else
{
    <div class="d-flex flex-wrap gap-3">
        @foreach (var item in _capabilities)
        {
            <div style="width: 320px;">
                <GovernorCard>
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div style="font-size:18px; font-weight:700; letter-spacing:-.01em;">@item.ModuleId</div>
                            <div style="font-size:12.5px; color:var(--gp-soft);">Portfolio @Shorten(item.PortfolioId) &middot; @item.FunctionalOwnerDepartment</div>
                        </div>
                        <StatusChip Label="@StatusLabel(item.ActivationStatus)" State="@StatusState(item.ActivationStatus)" />
                    </div>

                    @{
                        var allowed = AllowedNextStatuses(item.ActivationStatus);
                        var canAct = _profile is not null
                            && (_profile.IsAdmin || (item.FunctionalOwnerDepartment is not null && _profile.IsActiveMember(item.PortfolioId, item.FunctionalOwnerDepartment)));
                    }
                    @if (allowed.Count == 0)
                    {
                        <span style="font-size:12px; color:var(--gp-soft);">No further transitions (terminal state).</span>
                    }
                    else if (!canAct)
                    {
                        <span style="font-size:12px; color:var(--gp-soft);">No actions available to your account.</span>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            <PillButton Variant="PillButton.ButtonVariant.Primary" OnClick="@(() => OpenForm(item, RequestActionForm.ActionMode.Promote))">Promote</PillButton>
                            <PillButton Variant="PillButton.ButtonVariant.Secondary" OnClick="@(() => OpenForm(item, RequestActionForm.ActionMode.Override))">Request override</PillButton>
                            <PillButton Variant="PillButton.ButtonVariant.Secondary" OnClick="@(() => OpenForm(item, RequestActionForm.ActionMode.BreakGlass))">Raise break-glass</PillButton>
                        </div>
                    }
                </GovernorCard>
            </div>
        }
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<CapabilityRegistryEntry> _capabilities = new();
    private ResolvedCurrentUser? _profile;

    private CapabilityRegistryEntry? _activeCapability;
    private RequestActionForm.ActionMode? _activeMode;

    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    // Mirrors promote_capability_status's transition graph exactly (server/migrations/
    // 435_module_activation_lifecycle.sql) so the UI never offers an illegal target status --
    // the DB is still the enforcement point, this just avoids a guaranteed-400 round trip.
    // Review finding (PR #744): migration 442_capability_registry_draft_disable_transition.sql
    // added draft -> disabled to the DB's own transition graph (a break-glass decline against
    // a still-draft capability), but this mirror was never updated to match -- meaning a
    // legal, DB-supported transition couldn't actually be selected from this page at all.
    private static List<string> AllowedNextStatuses(string currentStatus) => currentStatus switch
    {
        "draft" => new List<string> { "pending_department_approval", "disabled" },
        "pending_department_approval" => new List<string> { "active", "disabled" },
        "active" => new List<string> { "pending_re_approval", "disabled" },
        "pending_re_approval" => new List<string> { "active", "disabled" },
        _ => new List<string>()
    };

    protected override async Task OnInitializedAsync()
    {
        _profile = await CurrentUser.GetAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var client = HttpClientFactory.CreateClient("api");
            var response = await client.GetAsync("api/Capability");
            if (response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadFromJsonAsync<CapabilityListResponse>(JsonOptions);
                _capabilities = body?.Capabilities ?? new();
            }
            else
            {
                _error = $"Could not load capabilities ({(int)response.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not load capabilities: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenForm(CapabilityRegistryEntry item, RequestActionForm.ActionMode mode)
    {
        _activeCapability = item;
        _activeMode = mode;
    }

    private void CloseForm()
    {
        _activeCapability = null;
        _activeMode = null;
    }

    private async Task OnFormCompleted()
    {
        CloseForm();
        await LoadAsync();
    }

    private static string Shorten(string id) => id.Length > 8 ? $"{id[..8]}…" : id;

    private static string StatusLabel(string activationStatus) => activationStatus switch
    {
        "active" => "Active",
        "pending_department_approval" => "Pending approval",
        "pending_re_approval" => "Pending re-approval",
        "disabled" => "Disabled",
        "draft" => "Draft",
        _ => activationStatus
    };

    private static StatusChip.ChipState StatusState(string activationStatus) => activationStatus switch
    {
        "active" => StatusChip.ChipState.Approved,
        "pending_department_approval" or "pending_re_approval" => StatusChip.ChipState.Pending,
        "disabled" => StatusChip.ChipState.Declined,
        _ => StatusChip.ChipState.Neutral
    };

    private sealed class CapabilityListResponse
    {
        [JsonPropertyName("capabilities")] public List<CapabilityRegistryEntry> Capabilities { get; set; } = new();
    }

    private sealed class CapabilityRegistryEntry
    {
        [JsonPropertyName("id")] public string Id { get; set; } = string.Empty;
        [JsonPropertyName("moduleId")] public string ModuleId { get; set; } = string.Empty;
        [JsonPropertyName("portfolioId")] public string PortfolioId { get; set; } = string.Empty;
        [JsonPropertyName("functionalOwnerDepartment")] public string? FunctionalOwnerDepartment { get; set; }
        [JsonPropertyName("activationStatus")] public string ActivationStatus { get; set; } = string.Empty;
    }
}
