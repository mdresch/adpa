@page "/approvals"
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization

<PageTitle>Approvals — Governor Portal</PageTitle>

<h1 class="h3 mb-1" style="font-family: var(--gp-font); color: var(--gp-ink);">Approvals</h1>
<p class="mb-4" style="color: var(--gp-soft);">Override requests and break-glass exceptions waiting on a decision.</p>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <p style="color: var(--gp-soft);">Loading&hellip;</p>
}
else
{
    <h2 class="h5 mb-3" style="font-family: var(--gp-font); color: var(--gp-ink);">Override requests</h2>
    @if (_overrides.Count == 0)
    {
        <p class="mb-4" style="color: var(--gp-soft);">Nothing pending.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-3 mb-5">
            @foreach (var item in _overrides)
            {
                <div style="max-width: 560px;">
                    <GovernorCard ShowBloom="true">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div style="font-size:18px; font-weight:700; letter-spacing:-.01em;">@item.ModuleId</div>
                                <div style="font-size:12.5px; color:var(--gp-soft);">Portfolio @Shorten(item.PortfolioId) &middot; @item.RequestedByDepartment</div>
                            </div>
                            <StatusChip Label="Pending review" State="StatusChip.ChipState.Pending" />
                        </div>

                        <JustificationBlock>@item.Justification</JustificationBlock>

                        <div class="d-flex gap-3 mb-3" style="font-size:12.5px; color:var(--gp-soft);">
                            <div>Target <b style="color:var(--gp-ink);">@item.RequestedNewStatus</b></div>
                            <div>Requested <b style="color:var(--gp-ink);">@item.RequestedAt.ToString("yyyy-MM-dd HH:mm")</b> UTC</div>
                        </div>

                        <div class="d-flex gap-2">
                            <PillButton Variant="PillButton.ButtonVariant.Approve" OnClick="@(() => ApproveOverride(item))">Approve override</PillButton>
                            <PillButton Variant="PillButton.ButtonVariant.Deny" OnClick="@(() => DenyOverride(item))">Deny</PillButton>
                        </div>
                    </GovernorCard>
                </div>
            }
        </div>
    }

    <h2 class="h5 mb-3" style="font-family: var(--gp-font); color: var(--gp-ink);">Break-glass exceptions</h2>
    @if (_exceptions.Count == 0)
    {
        <p class="mb-4" style="color: var(--gp-soft);">Nothing pending.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in _exceptions)
            {
                <div style="max-width: 560px;">
                    <GovernorCard ShowBloom="true">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div style="font-size:18px; font-weight:700; letter-spacing:-.01em;">@item.ModuleId</div>
                                <div style="font-size:12.5px; color:var(--gp-soft);">Portfolio @Shorten(item.PortfolioId) &middot; structural deadlock</div>
                            </div>
                            <StatusChip Label="Break-glass" State="StatusChip.ChipState.Pending" />
                        </div>

                        <JustificationBlock>@item.Justification</JustificationBlock>

                        <ReviewerStrip Reviewers="@BuildReviewerStatuses(item)" />

                        <div class="d-flex flex-wrap gap-2 mt-3">
                            @foreach (var review in item.Reviews.Where(r => r.Decision is null))
                            {
                                <PillButton Variant="PillButton.ButtonVariant.Approve" OnClick="@(() => DecideReview(item, review, "approved"))">Approve as @review.ReviewerCategory</PillButton>
                                <PillButton Variant="PillButton.ButtonVariant.Deny" OnClick="@(() => DecideReview(item, review, "declined"))">Decline as @review.ReviewerCategory</PillButton>
                            }
                            <PillButton Variant="PillButton.ButtonVariant.Primary" OnClick="@(() => Activate(item))">Activate (Super Admin)</PillButton>
                        </div>
                    </GovernorCard>
                </div>
            }
        </div>
    }
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<PendingOverride> _overrides = new();
    private List<PendingException> _exceptions = new();

    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var client = HttpClientFactory.CreateClient("api");

            var overridesResponse = await client.GetAsync("api/Capability/overrides/pending");
            if (overridesResponse.IsSuccessStatusCode)
            {
                var body = await overridesResponse.Content.ReadFromJsonAsync<PendingOverridesResponse>(JsonOptions);
                _overrides = body?.OverrideRequests ?? new();
            }
            else
            {
                _error = $"Could not load override requests ({(int)overridesResponse.StatusCode}).";
            }

            var exceptionsResponse = await client.GetAsync("api/Capability/exceptions/pending");
            if (exceptionsResponse.IsSuccessStatusCode)
            {
                var body = await exceptionsResponse.Content.ReadFromJsonAsync<PendingExceptionsResponse>(JsonOptions);
                _exceptions = body?.Exceptions ?? new();
            }
            else
            {
                _error = (_error is null ? "" : _error + " ") + $"Could not load break-glass exceptions ({(int)exceptionsResponse.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _error = $"Unable to reach the orchestrator: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApproveOverride(PendingOverride item)
    {
        var client = HttpClientFactory.CreateClient("api");
        var response = await client.PostAsync($"api/Capability/{item.ModuleId}/{item.PortfolioId}/override/{item.Id}/approve", null);
        await HandleActionResult(response, "approve the override request");
    }

    private async Task DenyOverride(PendingOverride item)
    {
        var client = HttpClientFactory.CreateClient("api");
        var response = await client.PostAsJsonAsync($"api/Capability/{item.ModuleId}/{item.PortfolioId}/override/{item.Id}/deny", new { reason = "Denied from the Governor Portal Approvals queue." });
        await HandleActionResult(response, "deny the override request");
    }

    private async Task DecideReview(PendingException item, ExceptionReview review, string decision)
    {
        var client = HttpClientFactory.CreateClient("api");
        var response = await client.PostAsJsonAsync(
            $"api/Capability/{item.ModuleId}/{item.PortfolioId}/exceptions/{item.Id}/reviews/{review.Id}/decide",
            new { decision });
        await HandleActionResult(response, $"record the {decision} decision");
    }

    private async Task Activate(PendingException item)
    {
        var client = HttpClientFactory.CreateClient("api");
        var response = await client.PostAsync($"api/Capability/{item.ModuleId}/{item.PortfolioId}/exceptions/{item.Id}/activate", null);
        await HandleActionResult(response, "activate the exception");
    }

    private async Task HandleActionResult(HttpResponseMessage response, string actionDescription)
    {
        if (response.IsSuccessStatusCode)
        {
            await LoadAsync();
            return;
        }

        var body = await response.Content.ReadAsStringAsync();
        _error = $"Could not {actionDescription} ({(int)response.StatusCode}): {body}";
    }

    private static List<ReviewerStrip.ReviewerStatus> BuildReviewerStatuses(PendingException item) =>
        item.Reviews.Select(r => new ReviewerStrip.ReviewerStatus(
            r.ReviewerLabel ?? r.ReviewerCategory,
            r.Decision switch
            {
                "approved" => StatusChip.ChipState.Approved,
                "declined" => StatusChip.ChipState.Declined,
                _ => StatusChip.ChipState.Pending
            })).ToList();

    private static string Shorten(string id) => id.Length > 8 ? $"{id[..8]}…" : id;

    private sealed class PendingOverridesResponse
    {
        [JsonPropertyName("overrideRequests")] public List<PendingOverride> OverrideRequests { get; set; } = new();
    }

    private sealed class PendingOverride
    {
        [JsonPropertyName("id")] public string Id { get; set; } = string.Empty;
        [JsonPropertyName("moduleId")] public string ModuleId { get; set; } = string.Empty;
        [JsonPropertyName("portfolioId")] public string PortfolioId { get; set; } = string.Empty;
        [JsonPropertyName("requestedNewStatus")] public string RequestedNewStatus { get; set; } = string.Empty;
        [JsonPropertyName("justification")] public string Justification { get; set; } = string.Empty;
        [JsonPropertyName("requestedByDepartment")] public string RequestedByDepartment { get; set; } = string.Empty;
        [JsonPropertyName("requestedAt")] public DateTimeOffset RequestedAt { get; set; }
    }

    private sealed class PendingExceptionsResponse
    {
        [JsonPropertyName("exceptions")] public List<PendingException> Exceptions { get; set; } = new();
    }

    private sealed class PendingException
    {
        [JsonPropertyName("id")] public string Id { get; set; } = string.Empty;
        [JsonPropertyName("moduleId")] public string ModuleId { get; set; } = string.Empty;
        [JsonPropertyName("portfolioId")] public string PortfolioId { get; set; } = string.Empty;
        [JsonPropertyName("requestedNewStatus")] public string RequestedNewStatus { get; set; } = string.Empty;
        [JsonPropertyName("justification")] public string Justification { get; set; } = string.Empty;
        [JsonPropertyName("raisedAt")] public DateTimeOffset RaisedAt { get; set; }
        [JsonPropertyName("reviews")] public List<ExceptionReview> Reviews { get; set; } = new();
    }

    private sealed class ExceptionReview
    {
        [JsonPropertyName("id")] public string Id { get; set; } = string.Empty;
        [JsonPropertyName("reviewerCategory")] public string ReviewerCategory { get; set; } = string.Empty;
        [JsonPropertyName("reviewerLabel")] public string? ReviewerLabel { get; set; }
        [JsonPropertyName("decision")] public string? Decision { get; set; }
    }
}
