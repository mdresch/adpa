@page "/"

<PageTitle>ADPA Governor Portal</PageTitle>

<div class="gp-home">
    <header class="gp-hero">
        <span class="gp-eyebrow">RPAS-CM v2.4.1 Baseline</span>
        <h1>Governance Center</h1>
        <p class="gp-lead">
            The authoritative framework for <strong>Regulated Process Assurance</strong> in AI-driven
            ecosystems — enforcing deterministic execution through machine-verifiable rituals.
        </p>
        <div class="d-flex justify-content-center gap-2 mt-4">
            <PillButton Href="/approvals" Variant="PillButton.ButtonVariant.Primary">Review approvals</PillButton>
            <PillButton Href="/ledger" Variant="PillButton.ButtonVariant.Secondary">Governance ledger</PillButton>
        </div>
    </header>

    <section class="gp-guardrails">
        <div class="gp-guardrail"><span>G1</span>Authority</div>
        <div class="gp-guardrail"><span>G2</span>Lifecycle</div>
        <div class="gp-guardrail"><span>G3</span>Evidence</div>
        <div class="gp-guardrail"><span>G4</span>Determinism</div>
        <div class="gp-guardrail"><span>G5</span>Read vs Act</div>
    </section>

    <section class="mt-5">
        <div class="text-center mb-4">
            <h2 class="h4" style="color: var(--gp-ink); font-family: var(--gp-font);">The 5 Mandatory Gates</h2>
            <p style="color: var(--gp-soft);">Every state transition must pass these five levels of integrity before certification.</p>
        </div>

        <div class="gp-gates">
            <GovernorCard>
                <div class="gp-gate-num">01</div>
                <h3 class="h6" style="color: var(--gp-ink);">Mechanical Integrity</h3>
                <p class="small" style="color: var(--gp-soft);">Verifies atomic change scope. Ensures only declared files are modified and no silent scope creep occurs.</p>
                <StatusChip Label="AEV Enforced" State="StatusChip.ChipState.Neutral" />
            </GovernorCard>
            <GovernorCard>
                <div class="gp-gate-num">02</div>
                <h3 class="h6" style="color: var(--gp-ink);">Build Integrity</h3>
                <p class="small" style="color: var(--gp-soft);">Ensures full source compilation, dependency resolution, and service mesh health via .NET Aspire.</p>
                <StatusChip Label="AEV Enforced" State="StatusChip.ChipState.Neutral" />
            </GovernorCard>
            <GovernorCard>
                <div class="gp-gate-num">03</div>
                <h3 class="h6" style="color: var(--gp-ink);">Topology Check</h3>
                <p class="small" style="color: var(--gp-soft);">DRACO-supervised validation of component graphs and service mesh consistency across tiers.</p>
                <StatusChip Label="DRACO Aware" State="StatusChip.ChipState.Pending" />
            </GovernorCard>
            <GovernorCard>
                <div class="gp-gate-num">04</div>
                <h3 class="h6" style="color: var(--gp-ink);">Attestation</h3>
                <p class="small" style="color: var(--gp-soft);">Machine-verifiable certification of compliance with G1-G5 guardrails against the TAR-COL schema.</p>
                <StatusChip Label="RPAS Certified" State="StatusChip.ChipState.Neutral" />
            </GovernorCard>
            <GovernorCard>
                <div class="gp-gate-num">05</div>
                <h3 class="h6" style="color: var(--gp-ink);">Semantic Audit</h3>
                <p class="small" style="color: var(--gp-soft);">Multi-agent Board Review (Evidence, Governance, Challenger) of intent to block Shadow Initiative.</p>
                <StatusChip Label="DRACO Active" State="StatusChip.ChipState.Approved" />
            </GovernorCard>
        </div>
    </section>

    <footer class="gp-boundary">
        <strong>Operational Boundary Notice:</strong> RPAS-CM enforces governance at the system level.
        This portal is strictly informational — all state transitions are authorized by Human Decision
        Rituals and enforced by the DRACO Board, .NET Orchestrator, and CI/CD pipelines.
    </footer>
</div>

<style>
    .gp-home { max-width: 1180px; margin: 0 auto; padding-bottom: 48px; }

    .gp-hero { text-align: center; padding: 48px 0 32px; }
    .gp-hero h1 {
        font-family: var(--gp-font);
        font-size: clamp(32px, 5vw, 46px);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--gp-ink);
        margin: 14px 0;
    }
    .gp-eyebrow {
        display: inline-block;
        font-family: var(--gp-font);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: var(--gp-pending-ink);
        background: var(--gp-pending-bg);
        padding: 5px 14px;
        border-radius: 999px;
    }
    .gp-lead { max-width: 62ch; margin: 0 auto; color: var(--gp-soft); font-size: 16px; line-height: 1.6; }

    .gp-guardrails { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
    .gp-guardrail {
        display: flex; flex-direction: column; align-items: center; gap: 2px;
        background: var(--gp-surface); border: 1px solid var(--gp-border); border-radius: 14px;
        padding: 12px 20px; min-width: 96px;
    }
    .gp-guardrail span { font-family: var(--gp-font); font-weight: 800; font-size: 15px; color: var(--gp-ink); }

    .gp-gates { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
    .gp-gate-num { font-family: var(--gp-font); font-size: 28px; font-weight: 800; color: var(--gp-border); margin-bottom: 4px; }
    .gp-gates h3 { margin-bottom: 6px; }
    .gp-gates p { margin-bottom: 12px; }

    .gp-boundary {
        margin-top: 48px; padding: 20px 24px; border-radius: 16px;
        background: var(--gp-surface); border: 1px solid var(--gp-border);
        color: var(--gp-soft); font-size: 13px; text-align: center;
    }
    .gp-boundary strong { color: var(--gp-ink); }
</style>
