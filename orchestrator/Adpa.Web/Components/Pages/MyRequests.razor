@page "/my-requests"
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@using System.Net.Http.Json
@using System.Text.Json

<PageTitle>My Requests — Governor Portal</PageTitle>

<h1 class="h3 mb-1" style="font-family: var(--gp-font); color: var(--gp-ink);">My Requests</h1>
<p class="mb-4" style="color: var(--gp-soft);">Your own override requests and break-glass exceptions, pending and decided.</p>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <p style="color: var(--gp-soft);">Loading&hellip;</p>
}
else
{
    <h2 class="h5 mb-3" style="font-family: var(--gp-font); color: var(--gp-ink);">Override requests</h2>
    @if (_overrides.Count == 0)
    {
        <p class="mb-4" style="color: var(--gp-soft);">You haven't raised any override requests.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-3 mb-5">
            @foreach (var item in _overrides)
            {
                <div style="max-width: 560px;">
                    <GovernorCard>
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div style="font-size:18px; font-weight:700; letter-spacing:-.01em;">@item.ModuleId</div>
                                <div style="font-size:12.5px; color:var(--gp-soft);">Portfolio @Shorten(item.PortfolioId) &middot; @item.RequestedByDepartment</div>
                            </div>
                            <StatusChip Label="@StatusLabel(item.Status)" State="@StatusState(item.Status)" />
                        </div>

                        <JustificationBlock>@item.Justification</JustificationBlock>

                        <div class="d-flex gap-3 mb-3" style="font-size:12.5px; color:var(--gp-soft);">
                            <div>Target <b style="color:var(--gp-ink);">@item.RequestedNewStatus</b></div>
                            <div>Requested <b style="color:var(--gp-ink);">@item.RequestedAt.ToString("yyyy-MM-dd HH:mm")</b> UTC</div>
                        </div>

                        <ChainProvenanceMarker ChainEntryId="@item.ChainEntryId" ChainRecordedAt="@item.ChainRecordedAt" />

                        @if (item.Status == "pending")
                        {
                            <div class="mt-2">
                                <PillButton Variant="PillButton.ButtonVariant.Secondary" OnClick="@(() => Withdraw(item))">Withdraw</PillButton>
                            </div>
                        }
                    </GovernorCard>
                </div>
            }
        </div>
    }

    <h2 class="h5 mb-3" style="font-family: var(--gp-font); color: var(--gp-ink);">Break-glass exceptions</h2>
    <p class="mb-2" style="font-size:12.5px; color:var(--gp-soft);">Read-only here — an exception can't be withdrawn once raised (ADR-012 §B).</p>
    @if (_exceptions.Count == 0)
    {
        <p style="color: var(--gp-soft);">You haven't raised any break-glass exceptions.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in _exceptions)
            {
                <div style="max-width: 560px;">
                    <GovernorCard>
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div style="font-size:18px; font-weight:700; letter-spacing:-.01em;">@item.ModuleId</div>
                                <div style="font-size:12.5px; color:var(--gp-soft);">Portfolio @Shorten(item.PortfolioId)</div>
                            </div>
                            <StatusChip Label="Break-glass" State="StatusChip.ChipState.Neutral" />
                        </div>

                        <JustificationBlock>@item.Justification</JustificationBlock>

                        <ReviewerStrip Reviewers="@BuildReviewerStatuses(item)" />

                        <ChainProvenanceMarker ChainEntryId="@item.ChainEntryId" ChainRecordedAt="@item.ChainRecordedAt" />
                    </GovernorCard>
                </div>
            }
        </div>
    }
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<PendingOverride> _overrides = new();
    private List<PendingException> _exceptions = new();

    private static readonly JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var client = HttpClientFactory.CreateClient("api");

            var overridesResponse = await client.GetAsync("api/Capability/overrides/mine");
            if (overridesResponse.IsSuccessStatusCode)
            {
                var body = await overridesResponse.Content.ReadFromJsonAsync<PendingOverridesResponse>(JsonOptions);
                _overrides = body?.OverrideRequests ?? new();
            }
            else
            {
                _error = $"Could not load your override requests ({(int)overridesResponse.StatusCode}).";
            }

            var exceptionsResponse = await client.GetAsync("api/Capability/exceptions/mine");
            if (exceptionsResponse.IsSuccessStatusCode)
            {
                var body = await exceptionsResponse.Content.ReadFromJsonAsync<PendingExceptionsResponse>(JsonOptions);
                _exceptions = body?.Exceptions ?? new();
            }
            else
            {
                _error = (_error is null ? "" : _error + " ") + $"Could not load your exceptions ({(int)exceptionsResponse.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _error = $"Unable to reach the orchestrator: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Withdraw(PendingOverride item)
    {
        var client = HttpClientFactory.CreateClient("api");
        var response = await client.PostAsync($"api/Capability/{item.ModuleId}/{item.PortfolioId}/override/{item.Id}/withdraw", null);
        if (response.IsSuccessStatusCode)
        {
            await LoadAsync();
        }
        else
        {
            var body = await response.Content.ReadAsStringAsync();
            _error = $"Could not withdraw the request ({(int)response.StatusCode}): {body}";
        }
    }

    private static List<ReviewerStrip.ReviewerStatus> BuildReviewerStatuses(PendingException item) =>
        item.Reviews.Select(r => new ReviewerStrip.ReviewerStatus(
            r.ReviewerLabel ?? r.ReviewerCategory,
            r.Decision switch
            {
                "approved" => StatusChip.ChipState.Approved,
                "declined" => StatusChip.ChipState.Declined,
                _ => StatusChip.ChipState.Pending
            })).ToList();

    private static string Shorten(string id) => id.Length > 8 ? $"{id[..8]}…" : id;

    private static string StatusLabel(string status) => status switch
    {
        "pending" => "Pending review",
        "approved" => "Approved",
        "denied" => "Denied",
        "withdrawn" => "Withdrawn",
        _ => status
    };

    private static StatusChip.ChipState StatusState(string status) => status switch
    {
        "approved" => StatusChip.ChipState.Approved,
        "denied" => StatusChip.ChipState.Declined,
        "withdrawn" => StatusChip.ChipState.Neutral,
        _ => StatusChip.ChipState.Pending
    };
}
