<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">ADPA Management</a>
            <div class="navbar-nav me-auto">
                <a class="nav-link" href="/ledger">Governance Ledger</a>
                <a class="nav-link" href="/requirements">Requirements Matrix</a>
                <a class="nav-link" href="/governance-center">Governance Center</a>
            </div>
            <AuthorizeView>
                <Authorized>
                    <span class="navbar-text text-light small me-3">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span>
                    <form method="post" action="/logout" class="d-inline">
                        <button type="submit" class="btn btn-outline-light btn-sm">Sign out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-outline-light btn-sm" href="/login">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>

    <Routes @rendermode="RenderMode.InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
