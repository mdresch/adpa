@* No shared LayoutComponentBase exists yet -- App.razor hardcodes the nav directly
   around <Routes>, so DefaultLayout is intentionally omitted here rather than
   introducing one as a side effect of adding auth. See ADR-009 design spec. *@
<Router AppAssembly="@typeof(Routes).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <p role="alert" class="container mt-4">Sorry, there's nothing at this address.</p>
    </NotFound>
</Router>
