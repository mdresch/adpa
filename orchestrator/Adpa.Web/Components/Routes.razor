@* ADR-011: MainLayout now exists (Components/Layout/MainLayout.razor) -- the
   deferral noted in ADR-009's design spec is resolved. Every routed page gets
   the shared nav/chrome by default; a page can still override with its own
   @layout directive if it ever needs to (none do today). *@
<Router AppAssembly="@typeof(Routes).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Layout.MainLayout)">
            <PageTitle>Not found</PageTitle>
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>
