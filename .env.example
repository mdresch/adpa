# ==============================================
# Core Configuration
# ==============================================
# Environment: development, production, test
NODE_ENV="development"
# Port for the server to listen on
PORT="5000"
# Logging level: debug, info, warn, error
LOG_LEVEL="info"

# ==============================================
# Frontend & API URLs
# ==============================================
# Base URL for the frontend application
FRONTEND_URL="http://localhost:3000"
# Base URL for the API
NEXT_PUBLIC_API_URL="http://localhost:5000"
# Base URL for WebSocket connections
NEXT_PUBLIC_WS_URL="http://localhost:5000"
# CORS Allowed Origins
CORS_ORIGIN="https://adpa.vercel.app"

# ==============================================
# Database Configuration (Supabase & Postgres)
# ==============================================
# Primary Database URL (Supabase Transaction Pooler)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Local / Standard DB Connection Details
DB_HOST="localhost"
DB_NAME="adpa_db"
DB_USER="postgres"
DB_PASSWORD="password"
DB_PORT="5432"
DB_SSL="true"

# Supabase Keys (Public & Service)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Standard Supabase Env Vars (often same as above)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Vercel / Cloud Postgres (Optional / Generated)
POSTGRES_URL=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_USER="postgres"
POSTGRES_HOST="db.[YOUR-PROJECT-REF].supabase.co"
POSTGRES_PASSWORD=""
POSTGRES_DATABASE="postgres"

# ==============================================
# Redis & KV Configuration
# ==============================================
# Primary Redis URL
REDIS_URL="redis://default:[PASSWORD]@[HOST]:[PORT]"
ADPA_REDIS_URL="rediss://default:[PASSWORD]@[HOST]:[PORT]"

# Upstash KV (ADPA)
ADPA_KV_URL="rediss://default:[PASSWORD]@[HOST]:[PORT]"
ADPA_KV_REST_API_URL="https://[YOUR-KV-REST-API-URL]"
ADPA_KV_REST_API_TOKEN="your-kv-rest-api-token"
ADPA_KV_REST_API_READ_ONLY_TOKEN="your-kv-rest-api-read-only-token"

# Upstash KV (RGA Redis)
adpa_rga_redis_KV_URL="rediss://default:[PASSWORD]@[HOST]:[PORT]"
adpa_rga_redis_REDIS_URL="rediss://default:[PASSWORD]@[HOST]:[PORT]"
adpa_rga_redis_KV_REST_API_URL="https://[YOUR-KV-REST-API-URL]"
adpa_rga_redis_KV_REST_API_TOKEN="your-kv-rest-api-token"
adpa_rga_redis_KV_REST_API_READ_ONLY_TOKEN="your-kv-rest-api-read-only-token"

# Other Redis Configs
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_DB="0"
REDIS_PASSWORD=""
REDISUSER="default"
REDISPASSWORD="${{REDIS_PASSWORD}}"
REDISHOST=""
REDISPORT="6379"
REDIS_TLS="true"
REDIS_PUBLIC_URL="redis://default:${{REDIS_PASSWORD}}@${{RAILWAY_TCP_PROXY_DOMAIN}}:${{RAILWAY_TCP_PROXY_PORT}}"

# ==============================================
# Authentication & Security
# ==============================================
# Secret key for JWT signing
JWT_SECRET="your-jwt-secret"
# Session Secret
SESSION_SECRET="your-session-secret-key"
# BCrypt Rounds
BCRYPT_ROUNDS="12"

# ==============================================
# AI Services & LLMs
# ==============================================
# OpenAI
OPENAI_API_KEY="your-openai-api-key"

# Azure OpenAI
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"

# Google AI (Gemini)
GOOGLE_AI_API_KEY="your-google-ai-api-key"
# GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-api-key" # Deprecated in favor of GOOGLE_AI_API_KEY

# Tavily (Search)
TAVILY_API_KEY="your-tavily-api-key"

# ==============================================
# Third-Party Integrations
# ==============================================
# GitHub
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_TOKEN="your-github-token"

# Microsoft / SharePoint / Teams
SHAREPOINT_CLIENT_ID="your-sharepoint-client-id"
SHAREPOINT_CLIENT_SECRET="your-sharepoint-client-secret"
SHAREPOINT_TENANT_ID="your-sharepoint-tenant-id"
TEAMS_WEBHOOK_URL="https://your-teams-webhook-url"

# Slack
SLACK_BOT_TOKEN="xoxb-your-slack-bot-token"

# Google Analytics
GOOGLE_ANALYTICS_ID="your-ga-id"

# Sentry
SENTRY_DSN="your-sentry-dsn"

# ==============================================
# Email (SMTP)
# ==============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="ADPA Framework <noreply@adpa.com>"

# ==============================================
# Vercel & TurboRepo
# ==============================================
VERCEL="1"
VERCEL_ENV="production"
VERCEL_TARGET_ENV="production"
VERCEL_OIDC_TOKEN=""
VERCEL_URL=""
# Vercel Git Metadata (Empty by default)
VERCEL_GIT_COMMIT_AUTHOR_LOGIN=""
VERCEL_GIT_COMMIT_AUTHOR_NAME=""
VERCEL_GIT_COMMIT_MESSAGE=""
VERCEL_GIT_COMMIT_REF=""
VERCEL_GIT_COMMIT_SHA=""
VERCEL_GIT_PREVIOUS_SHA=""
VERCEL_GIT_PROVIDER=""
VERCEL_GIT_PULL_REQUEST_ID=""
VERCEL_GIT_REPO_ID=""
VERCEL_GIT_REPO_OWNER=""
VERCEL_GIT_REPO_SLUG=""

TURBO_CACHE="remote:rw"
TURBO_DOWNLOAD_LOCAL_ENABLED="true"
TURBO_REMOTE_ONLY="true"
TURBO_RUN_SUMMARY="true"
NX_DAEMON="false"

# ==============================================
# Caching Strategies (Seconds)
# ==============================================
CACHE_TTL_DEFAULT="3600"
CACHE_TTL_DOCUMENT="1800"
CACHE_TTL_TEMPLATE="3600"
CACHE_TTL_USER="1800"

# ==============================================
# File Uploads
# ==============================================
UPLOAD_ALLOWED_TYPES="application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain"
UPLOAD_MAX_SIZE="10485760"

# ==============================================
# Miscellaneous / Generated
# ==============================================
FAMILY="4"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"

# --- Added during 2026-07-01 env cleanup: keys present in the real file but missing from this template ---
