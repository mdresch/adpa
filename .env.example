LANGFUSE_SECRET_KEY=
LOCAL_AI_AUTO_START=
MISTRAL_API_KEY=
MISTRAL_MODEL=
MONGODB_DB_NAME=
MONGODB_URI=
MORPHIC_DATABASE_URL=
MORPHIC_DB_SSL=
NEO4J_DATABASE=
NEO4J_PASSWORD=
NEO4J_URI=
NEO4J_USERNAME=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
